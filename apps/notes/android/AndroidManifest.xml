<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.heartnetapps.notes">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Notes"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="dev.heartnetapps.kit.KitActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density|smallestScreenSize|navigation|keyboard"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="notes" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
